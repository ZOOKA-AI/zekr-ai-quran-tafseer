{
  "name": "Orphan",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "age": {
      "type": "number",
      "description": "\u0627\u0644\u0639\u0645\u0631"
    },
    "guardian_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0648\u0635\u064a"
    },
    "guardian_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0627\u0644\u0648\u0635\u064a"
    },
    "address": {
      "type": "string",
      "description": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629"
    },
    "monthly_needs": {
      "type": "number",
      "description": "\u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0634\u0647\u0631\u064a\u0629 \u0628\u0627\u0644\u062f\u0648\u0644\u0627\u0631"
    },
    "transfer_method": {
      "type": "string",
      "enum": [
        "vodafone_cash",
        "bank_transfer",
        "iban",
        "ai_transfer"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644"
    },
    "account_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062d\u0633\u0627\u0628 \u0623\u0648 \u0627\u0644\u0645\u062d\u0641\u0638\u0629"
    },
    "bank_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643 (\u0625\u0646 \u0648\u062c\u062f)"
    },
    "iban": {
      "type": "string",
      "description": "\u0631\u0642\u0645 IBAN (\u0625\u0646 \u0648\u062c\u062f)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "active",
        "completed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628"
    },
    "total_received": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u0644\u0645\u0629"
    },
    "last_transfer_date": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0622\u062e\u0631 \u062a\u062d\u0648\u064a\u0644"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a"
    }
  },
  "required": [
    "full_name",
    "age",
    "guardian_name",
    "guardian_phone",
    "address",
    "country",
    "monthly_needs"
  ]
}