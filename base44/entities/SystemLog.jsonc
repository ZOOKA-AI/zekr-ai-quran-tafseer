{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "action_type": {
      "type": "string",
      "enum": [
        "update",
        "prayer",
        "read_verse",
        "memorize",
        "achievement",
        "bookmark",
        "listen",
        "duaa",
        "adhkar",
        "search",
        "navigation",
        "voice_command",
        "camera_scan"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "action_details": {
      "type": "string",
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "android",
        "ios",
        "windows"
      ],
      "default": "web",
      "description": "\u0627\u0644\u0645\u0646\u0635\u0629"
    },
    "device_info": {
      "type": "string",
      "description": "\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062c\u0647\u0627\u0632"
    },
    "app_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "pending"
      ],
      "default": "success",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631"
    }
  },
  "required": [
    "action_type",
    "action_details"
  ]
}