{
  "name": "MemorizationProgress",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u062e\u0637\u0629 \u0627\u0644\u062d\u0641\u0638"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645"
    },
    "verses_done": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0622\u064a\u0627\u062a \u0627\u0644\u0645\u0646\u062c\u0632\u0629"
    },
    "surah_number": {
      "type": "number",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629"
    },
    "from_verse": {
      "type": "number",
      "description": "\u0645\u0646 \u0622\u064a\u0629"
    },
    "to_verse": {
      "type": "number",
      "description": "\u0625\u0644\u0649 \u0622\u064a\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "quality_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u062a\u0642\u064a\u064a\u0645 \u062c\u0648\u062f\u0629 \u0627\u0644\u062d\u0641\u0638"
    }
  },
  "required": [
    "plan_id",
    "date",
    "verses_done"
  ]
}