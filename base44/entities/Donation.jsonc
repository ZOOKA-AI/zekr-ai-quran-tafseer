{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062a\u0628\u0631\u0639"
    },
    "donor_email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "donor_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0628\u0627\u0644\u062f\u0648\u0644\u0627\u0631"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "vodafone_cash",
        "bank_transfer",
        "iban",
        "ai_transfer",
        "other"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629"
    },
    "donation_type": {
      "type": "string",
      "enum": [
        "general",
        "specific_orphan",
        "monthly"
      ],
      "default": "general",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062a\u0628\u0631\u0639"
    },
    "orphan_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u064a\u062a\u064a\u0645 (\u0644\u0644\u062a\u0628\u0631\u0639 \u0627\u0644\u0645\u062e\u0635\u0635)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "transferred",
        "completed"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0628\u0631\u0639"
    },
    "admin_notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0623\u062f\u0645\u0646"
    },
    "receipt_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0627\u0644\u0625\u064a\u0635\u0627\u0644"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "\u062a\u0628\u0631\u0639 \u0645\u062c\u0647\u0648\u0644"
    }
  },
  "required": [
    "amount",
    "payment_method"
  ]
}